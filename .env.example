# ============================================================
# FOT Past Papers Portal — environment variables
# ============================================================
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# On Cloudflare Pages set these in the project dashboard
# (Settings → Environment variables) for BOTH the Production and
# Preview environments.
#
# Server-side code reads them at runtime: `next-on-pages` proxies
# `process.env` onto the Pages `env` binding, so a value can be added
# or rotated in the dashboard without a rebuild. The exception is
# anything prefixed `NEXT_PUBLIC_`, which Next.js inlines into the
# client bundle at build time and therefore does need a redeploy.
#
# Never commit a real `.env`. It is gitignored; this example is not.

# ------------------------------------------------------------
# Postgres (Neon) — REQUIRED
# ------------------------------------------------------------
# The pooled connection string from the Neon dashboard. Use the
# `-pooler` host so serverless connections are multiplexed.
#
# Read by: lib/db.ts, lib/statsStore.ts, the api routes, and the
# scripts under scripts/ (via postgres()). Also read implicitly by
# @vercel/postgres.
POSTGRES_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Fallback name read only by scripts/import_papers_to_db.py. Leave
# unset unless you are running that importer against a different
# database than POSTGRES_URL.
# DATABASE_URL="postgresql://..."

# ------------------------------------------------------------
# Feature flags — BUILD TIME
# ------------------------------------------------------------
# Next.js inlines NEXT_PUBLIC_* values into the client bundle at build
# time, so changing one requires a redeploy — editing it in the Pages
# dashboard alone is not enough. Read by lib/flags.ts.

# Usage tracking: presence heartbeats, the live badge, the view/open
# counters and the /stats dashboard.
#
# Keep this "false" while the Upstash quota is under pressure. A
# heartbeat costs 11 billed Redis commands and a badge poll costs 10,
# i.e. ~31 commands per minute per open tab, against a free tier that
# only affords ~11.6/min. When false, lib/presence.ts returns empty
# results without ever constructing a Redis client.
NEXT_PUBLIC_STATS_ENABLED="false"

# ------------------------------------------------------------
# Upstash Redis — REQUIRED for the paper catalogue cache
# ------------------------------------------------------------
# Read implicitly by Redis.fromEnv() in lib/cache.ts (paper catalogue
# and filter-option cache) and lib/drive.ts (Drive token and folder-id
# cache). Nothing else uses Redis: rate limiting moved to Cloudflare's
# WAF, and usage tracking is behind NEXT_PUBLIC_STATS_ENABLED.
#
# The free tier allows 500,000 commands per month. The catalogue cache
# reads at most once per 120 seconds per isolate, so it fits easily.
# When the quota runs out every command fails — including PING — and
# the catalogue falls back to querying Postgres on every request. The
# site stays up, just slower.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token"

# ------------------------------------------------------------
# Google Drive — REQUIRED for paper contributions
# ------------------------------------------------------------
# Read by lib/drive.ts. Without all three, POST /api/contribute
# answers 503 and no upload can be stored.
#
# Setup, once:
#   1. Google Cloud project with the Drive API enabled.
#   2. OAuth client of type "Web application".
#   3. OAuth consent screen published in PRODUCTION status.
#      An app left in "Testing" issues refresh tokens that expire
#      after 7 days, which breaks uploads silently.
#   4. Scope: https://www.googleapis.com/auth/drive.file
#   5. Authorise once, then exchange the code for a refresh token:
#        https://accounts.google.com/o/oauth2/v2/auth
#          ?client_id=...&redirect_uri=...&response_type=code
#          &scope=https://www.googleapis.com/auth/drive.file
#          &access_type=offline&prompt=consent
#        curl -X POST https://oauth2.googleapis.com/token \
#          -d client_id=... -d client_secret=... \
#          -d code=... -d grant_type=authorization_code
#
# The refresh token is a long-lived credential with write access to
# the account's Drive. Treat it like a password.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_oauth_client_secret"
GOOGLE_REFRESH_TOKEN="1//your_refresh_token"

# ------------------------------------------------------------
# Hashing peppers — set in production
# ------------------------------------------------------------
# Both have a hard-coded development fallback, so the app runs
# without them. That fallback is public knowledge (it is in the
# source), which makes the hashes reversible by anyone who reads the
# repository. Set a long random value in production.
#
# Generate each with:  openssl rand -hex 32

# Salts the SHA-256 hash of a submitter's IP address. The raw IP is
# never stored. Read by lib/submissions.ts.
SUBMISSIONS_PEPPER=""

# Salts the SHA-256 hash of a visitor's session id before it is
# written to Redis for presence tracking (only while
# NEXT_PUBLIC_STATS_ENABLED is "true"). Read by lib/presence.ts.
STATS_PEPPER=""

# ------------------------------------------------------------
# Scheduled cleanup — REQUIRED for the expiry job
# ------------------------------------------------------------
# Shared secret for POST /api/admin/cleanup, which moves submissions
# older than 30 days to the Rejected folder. The endpoint answers
# 503 when this is unset, so the job does nothing.
#
# Read by app/api/admin/cleanup/route.ts. The same value must be
# set as the GitHub Actions secret CLEANUP_SECRET. Generate with:
#   openssl rand -hex 32
CLEANUP_SECRET=""

# ------------------------------------------------------------
# Public site URL — optional
# ------------------------------------------------------------
# Absolute origin used for the sitemap and robots.txt. Defaults to
# https://past-paper-portal.pages.dev when unset. Read by
# app/sitemap.ts and app/robots.ts.
NEXT_PUBLIC_SITE_URL="https://past-paper-portal.pages.dev"

# ------------------------------------------------------------
# Contributor data — optional
# ------------------------------------------------------------
# Read by scripts/fetch-contributors.mjs, which bakes
# data/github-contributors.json for the Contributors wall. It is a
# build/CI script only; the app never calls the GitHub API at
# runtime.
#
# A token raises the GitHub API limit from 60 to 5,000 requests per
# hour. One unauthenticated run per day is well within 60, so the
# token is optional.
# GITHUB_TOKEN="ghp_..."
# GITHUB_REPO="viduwaa/past-paper-portal"

# ============================================================
# Not needed
# ============================================================
# The README's older setup block mentions POSTGRES_PRISMA_URL,
# POSTGRES_URL_NON_POOLING, POSTGRES_USER, POSTGRES_HOST,
# POSTGRES_PASSWORD and POSTGRES_DATABASE. Those are leftovers from
# the Vercel Postgres dashboard; the app reads only POSTGRES_URL.
